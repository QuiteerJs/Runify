registry=https://registry.npmmirror.com
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
sqlite3_mirror=https://cdn.npmmirror.com/binaries/sqlite3/

# https://pnpm.io/zh/npmrc#strict-peer-dependencies
strict-peer-dependencies=false
# https://pnpm.io/zh/cli/run#shell-emulator
shell-emulator=true
# https://pnpm.io/zh/npmrc#auto-install-peers
auto-install-peers=false
# https://pnpm.io/zh/npmrc#node-linker
# 沙箱文件代理拒绝 .pnpm 嵌套符号链接，改用 hoisted 平铺（硬链接）规避 BROKER_DENY
node-linker=hoisted


public-hoist-pattern[]=electron
public-hoist-pattern[]=vite
public-hoist-pattern[]=@vitejs/*
public-hoist-pattern[]=vue
public-hoist-pattern[]=@vue/*

# 曾为规避 WorkBuddy 沙箱的文件代理拦截（ERR_PNPM_CODEBUDDY_BROKER_DENY，
# 拒绝跳出工作区的 symlink）而把 store 放进工作区，现已不需要：
# 该代理是通过 NODE_OPTIONS 注入的 shim，用 `env -u NODE_OPTIONS pnpm install` 即可绕过。
# 保留默认（全局 store）以便复用 ~/.pnpm-store 缓存，避免每次重装都重新下载。

# https://pnpm.io/npmrc#minimum-release-age
# 供应链安全：包发布后最少等待多久才允许安装（默认 24h，会导致刚发布的包无法安装）
# 本地开发设为 0 关闭校验；生产环境建议保持默认或设为 6~12h
minimum-release-age=0
